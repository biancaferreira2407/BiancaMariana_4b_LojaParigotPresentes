# Copie este arquivo para ".env" e preencha com os seus valores.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nome_do_banco
DB_USER=postgres
DB_PASSWORD=sua_senha_do_banco

# Texto longo e aleatório (use algo como: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=troque_por_um_segredo_longo_e_aleatorio

# Conta Gmail que envia o código de recuperação de senha (use "senha de app", não a senha normal)
EMAIL_USER=seu_email@gmail.com
EMAIL_APP_PASSWORD=senha_de_app_do_gmail

PORT=3001
